// fastfetch do WatermelonOS (para personalizar: ~/.config/fastfetch/config.jsonc)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1          ▄\n$1         ███\n$1        ██$3▪$1██\n$1       ███████\n$1      ██$3▪$1███$3▪$1▀\n$1     ████████\n$1    ██$3▪$1███$3▪$1███▄\n$1   ████████████████\n$1  ██$3▪$1████$3▪$1████$3▪$1███\n$4 ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\n$2  ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀",
    "color": {
      "1": "38;2;255;84;104",
      "2": "38;2;30;122;60",
      "3": "38;2;42;26;23",
      "4": "38;2;168;230;161"
    },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;255;84;104", "title": "38;2;125;211;160" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;255;84;104mwatermelon\u001b[0mOS · feito para quem desenvolve" },
    "break",
    { "type": "os", "key": "󰌽 Sistema" },
    { "type": "host", "key": "󰍹 Máquina" },
    { "type": "uptime", "key": "󰅐 Ligado há" },
    { "type": "shell", "key": " Shell" },
    { "type": "de", "key": "󰧨 Desktop" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "cpu", "key": "󰻠 CPU" },
    { "type": "gpu", "key": "󰍛 GPU" },
    { "type": "memory", "key": "󰑭 Memória" },
    { "type": "disk", "key": "󰋊 Disco", "folders": "/" },
    "break",
    "colors"
  ]
}
