# Padrões do Git no WatermelonOS (seu ~/.gitconfig tem prioridade)
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	ff = only
[rebase]
	autoStash = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
