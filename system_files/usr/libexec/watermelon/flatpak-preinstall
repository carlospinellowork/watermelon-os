#!/usr/bin/env bash
# Instala os apps padrão do WatermelonOS (lista em /usr/share/watermelon/flatpaks.list).
# Roda no boot até conseguir; apps que a pessoa desinstalar não voltam.
set -uo pipefail
LIST=/usr/share/watermelon/flatpaks.list
STATE=/var/lib/watermelon/flatpaks-installed
mkdir -p "$(dirname "$STATE")" && touch "$STATE"

flatpak remote-add --system --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo || exit 1
fail=0
while read -r app; do
  [[ -z $app || $app == \#* ]] && continue
  grep -qxF "$app" "$STATE" && continue            # já instalado antes (ou removido pela pessoa)
  if flatpak install --system -y --noninteractive flathub "$app"; then
    echo "$app" >> "$STATE"
  else
    fail=1
  fi
done < "$LIST"
exit $fail
