#!/usr/bin/env bash
# Roda a cada boot (rápido e idempotente):
#   1. entrada da placa-mãe (UEFI) com o nome "WatermelonOS" em vez de "Fedora"
#   2. Windows detectado em qualquer disco aparece no menu de boot (dual boot)
#   3. no primeiro boot, o sistema ocupa todo o espaço livre do disco
set -uo pipefail
STATE=/var/lib/watermelon
mkdir -p "$STATE"
log() { echo "[boot-setup] $*"; }

# ------------------------------------------------------------------ 1. nome no menu da placa-mãe
if [ -d /sys/firmware/efi ] && command -v efibootmgr >/dev/null; then
  efibootmgr -v 2>/dev/null | grep -E '^Boot[0-9A-F]{4}\*? Fedora' | while read -r line; do
    num=$(sed -E 's/^Boot([0-9A-F]{4}).*/\1/' <<<"$line")
    partuuid=$(grep -oE 'HD\([0-9]+,GPT,[0-9a-f-]+' <<<"$line" | cut -d, -f3)
    loader=$(grep -oE '\\EFI\\[^)]*\.efi' <<<"$line" | head -1)
    dev=$(blkid -t PARTUUID="$partuuid" -o device 2>/dev/null | head -1)
    [ -n "$dev" ] && [ -n "$loader" ] || continue
    disk="/dev/$(lsblk -no PKNAME "$dev")"
    part=$(cat "/sys/class/block/$(basename "$dev")/partition")
    if efibootmgr -q --create --disk "$disk" --part "$part" --loader "$loader" --label "WatermelonOS"; then
      efibootmgr -q -b "$num" -B && log "entrada UEFI Boot$num renomeada para WatermelonOS"
    fi
  done
fi

# ------------------------------------------------------------------ 2. Windows no menu de boot
CUSTOM=/boot/grub2/custom.cfg
entries=""
while read -r dev fstype; do
  [ "$fstype" = "vfat" ] || continue
  mnt=$(mktemp -d)
  if mount -o ro "$dev" "$mnt" 2>/dev/null; then
    if [ -f "$mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
      uuid=$(blkid -s UUID -o value "$dev")
      entries+="
menuentry 'Windows' --class windows --class os \$menuentry_id_option 'windows-$uuid' {
  insmod part_gpt
  insmod fat
  insmod chain
  search --no-floppy --fs-uuid --set=root $uuid
  chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}"
      log "Windows encontrado em $dev"
    fi
    umount "$mnt"
  fi
  rmdir "$mnt"
done < <(lsblk -rno PATH,FSTYPE)

if [ -n "$entries" ]; then
  new="# Gerado pelo WatermelonOS (watermelon-boot-setup): dual boot com Windows
set timeout_style=menu
set timeout=5
$entries"
  if [ "$(cat "$CUSTOM" 2>/dev/null)" != "$new" ]; then
    printf '%s\n' "$new" > "$CUSTOM" && log "menu de boot atualizado"
  fi
elif grep -q 'watermelon-boot-setup' "$CUSTOM" 2>/dev/null; then
  rm -f "$CUSTOM"   # o Windows não existe mais
fi

# ------------------------------------------------------------------ 3. ocupar o disco inteiro (uma vez)
if [ ! -e "$STATE/root-grown" ]; then
  src=$(findmnt -no SOURCE /sysroot | sed 's/\[.*//')
  if [ -b "$src" ] && [ -e "/sys/class/block/$(basename "$src")/partition" ]; then
    disk="/dev/$(lsblk -no PKNAME "$src")"
    part=$(cat "/sys/class/block/$(basename "$src")/partition")
    if growpart "$disk" "$part" >/dev/null 2>&1; then
      case "$(findmnt -no FSTYPE /sysroot)" in
        btrfs) btrfs filesystem resize max /sysroot >/dev/null ;;
        xfs)   xfs_growfs /sysroot >/dev/null ;;
        ext4)  resize2fs "$src" >/dev/null ;;
      esac
      log "sistema expandido para o disco inteiro ($disk)"
    fi
  fi
  touch "$STATE/root-grown"
fi
exit 0
