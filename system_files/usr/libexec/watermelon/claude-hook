#!/usr/bin/python3
"""Hook do Claude Code -> ilha do Claude na barra do WatermelonOS.

Configurado em ~/.claude/settings.json (o primeiro login faz isso):
  UserPromptSubmit -> "trabalhando"   Notification -> "precisa de você"
  Stop -> "pronto"                     SessionEnd -> some da ilha
Recebe o JSON do evento na entrada e grava ~/.local/state/watermelon/claude/<sessão>.json,
que a extensão watermelon-shell acompanha.
"""
import json
import os
import sys
import time

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "watermelon", "claude")
EVENTS = {"UserPromptSubmit": "working", "Notification": "waiting", "Stop": "done", "SessionEnd": None}

raw = sys.stdin.read()   # lê tudo antes de qualquer saída (o Claude Code pode ainda estar escrevendo)
try:
    data = json.loads(raw)
except ValueError:
    sys.exit(0)
event = sys.argv[1] if len(sys.argv) > 1 else data.get("hook_event_name", "")

# chamadas internas do melon (commit, PR, revisão…) não são sessões suas: não aparecem na ilha.
# SessionEnd sempre passa, para nunca deixar uma sessão fantasma.
if os.environ.get("WATERMELON_NO_ISLAND") == "1" and event != "SessionEnd":
    sys.exit(0)
session = "".join(c for c in str(data.get("session_id", "")) if c.isalnum() or c == "-") or "sessao"
path = os.path.join(STATE, f"{session}.json")
os.makedirs(STATE, exist_ok=True)

state = EVENTS.get(event, "working")
if state is None:
    try:
        os.unlink(path)
    except OSError:
        pass
    sys.exit(0)

cwd = data.get("cwd") or os.getcwd()
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({"state": state, "cwd": cwd, "project": os.path.basename(cwd), "ts": time.time(),
               "message": data.get("message", "")}, f)
os.replace(tmp, path)   # troca atômica: a extensão nunca lê arquivo pela metade
