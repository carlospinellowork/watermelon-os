#!/usr/bin/env bash
# Primeiro login de cada usuário.
# O Claude Code é instalado na home do usuário (e não na imagem) porque ele
# se atualiza sozinho, e /usr é somente leitura num sistema imutável.
set -euo pipefail

STATE="$HOME/.local/state/watermelon"
mkdir -p "$STATE" "$HOME/.local/bin"
log() { echo "[watermelon] $*"; }

# Espera a rede (até 5 min): o primeiro login pode acontecer antes do Wi-Fi.
for _ in $(seq 1 60); do
  curl -fsSL --max-time 8 -o /dev/null https://claude.ai/install.sh && break
  sleep 5
done

if ! command -v claude >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/claude" ]; then
  log "instalando Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Botões das janelas estilo macOS: só na primeira vez (depois quem manda é o app Personalizar)
if [ ! -f "$STATE/traffic-lights.done" ]; then
  for v in 4 3; do
    css="$HOME/.config/gtk-$v.0/gtk.css"
    mkdir -p "$(dirname "$css")"
    grep -q 'watermelon: botões macOS' "$css" 2>/dev/null \
      || sed -i "1i @import url(\"file:///usr/share/watermelon/gtk/traffic-lights-gtk$v.css\"); /* watermelon: botões macOS */" "$css" 2>/dev/null \
      || echo "@import url(\"file:///usr/share/watermelon/gtk/traffic-lights-gtk$v.css\"); /* watermelon: botões macOS */" > "$css"
  done
  # apps Flatpak leem o mesmo CSS (e o arquivo importado, em /usr/share)
  flatpak override --user --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-config/gtk-3.0:ro \
    --filesystem=/usr/share/watermelon/gtk:ro 2>/dev/null || true
  touch "$STATE/traffic-lights.done"
fi

# Spotify pelo X11: no Wayland ele desenha uma barra de título própria (azul, fora do tema).
# Pelo X11 o GNOME desenha a barra do sistema, com os botões 🔴🟡🟢.
if [ ! -f "$STATE/spotify-x11.done" ]; then
  flatpak override --user --nosocket=wayland --socket=x11 com.spotify.Client 2>/dev/null || true
  touch "$STATE/spotify-x11.done"
fi

# Cache de exemplos do tldr (tealdeer)
command -v tldr >/dev/null 2>&1 && tldr --update >/dev/null 2>&1 || true

touch "$STATE/user-setup.done"
log "pronto"
