#!/usr/bin/env bash
# melon install <arquivo> — instalador universal do WatermelonOS
#   .exe .msi      -> Bottles (Wine), num "bottle" compartilhado
#   .apk           -> Waydroid (Android em container)
#   .deb           -> container Ubuntu (distrobox) + atalho no menu
#   .rpm           -> container Fedora (distrobox) + atalho no menu
#   .AppImage      -> ~/Applications + atalho no menu
#   .flatpakref    -> Flatpak
set -euo pipefail

RED=$'\e[38;2;255;84;104m' GRN=$'\e[38;2;125;211;160m' YEL=$'\e[38;2;242;197;107m' DIM=$'\e[2m' OFF=$'\e[0m'
step() { printf '\n%s🍉 %s%s\n' "$RED" "$*" "$OFF"; }
ok()   { printf '   %s✔%s %s\n' "$GRN" "$OFF" "$*"; }
info() { printf '   %s%s%s\n' "$DIM" "$*" "$OFF"; }
warn() { printf '   %s!%s %s\n' "$YEL" "$OFF" "$*"; }
die()  { printf '   %s✘ %s%s\n' "$RED" "$*" "$OFF" >&2; exit 1; }

FILE=${1:-}
[[ -n $FILE ]] || die "uso: melon install <arquivo.exe|.msi|.apk|.deb|.rpm|.AppImage|.flatpakref>"
[[ -f $FILE ]] || die "arquivo não encontrado: $FILE"
FILE=$(realpath "$FILE")
NAME=$(basename "$FILE")

APPS_DIR="$HOME/.local/share/applications"
mkdir -p "$APPS_DIR"

flatpak_ensure() {  # flatpak_ensure <app-id> <nome amigável>
  if ! flatpak info "$1" >/dev/null 2>&1; then
    info "primeira vez: instalando $2 (só acontece uma vez)"
    flatpak install --user -y --noninteractive flathub "$1"
  fi
}

# ------------------------------------------------------------------ Windows
BOTTLE="Apps"
BOTTLE_ROOT="$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles/$BOTTLE"
BOTTLES_CLI=(flatpak run --command=bottles-cli com.usebottles.bottles)

win_programs() {  # id<TAB>nome<TAB>pasta<TAB>executável de cada programa que o Bottles conhece
  "${BOTTLES_CLI[@]}" -j programs -b "$BOTTLE" 2>/dev/null | tail -1 \
    | jq -r '.[] | [.id, .name, .folder, .executable] | @tsv' 2>/dev/null || true
}

# Programas .NET 5+ trazem um *.runtimeconfig.json dizendo qual runtime precisam.
# Se o runtime não estiver no ambiente, baixa o oficial da Microsoft e instala em silêncio.
ensure_dotnet() {  # ensure_dotnet <arquivo marcador: só olha o que foi instalado depois dele>
  local marker=$1 cfg name version major kind dir exe
  local cache="$HOME/.cache/watermelon/dotnet"
  while IFS= read -r -d '' cfg; do
    while read -r name version; do
      [[ -n $name && -n $version ]] || continue
      major=${version%%.*}
      dir="$BOTTLE_ROOT/drive_c/Program Files/dotnet/shared/$name"
      compgen -G "$dir/$major.*" >/dev/null && continue
      case $name in
        Microsoft.WindowsDesktop.App) kind=windowsdesktop-runtime ;;
        Microsoft.NETCore.App)        kind=dotnet-runtime ;;
        Microsoft.AspNetCore.App)     kind=aspnetcore-runtime ;;
        *) continue ;;
      esac
      info "o programa precisa do .NET $major ($name): instalando (só acontece uma vez)"
      mkdir -p "$cache"
      exe="$cache/$kind-$major-win-x64.exe"
      [[ -s $exe ]] || curl -fL --progress-bar -o "$exe" "https://aka.ms/dotnet/$major.0/$kind-win-x64.exe"
      flatpak override --user --filesystem="$cache":ro com.usebottles.bottles
      "${BOTTLES_CLI[@]}" run -b "$BOTTLE" -e "$exe" /install /quiet /norestart >/dev/null 2>&1 || true
      if compgen -G "$dir/$major.*" >/dev/null; then
        ok ".NET $major instalado"
      else
        warn "não confirmei o .NET $major; se o programa não abrir, rode: melon install $exe"
      fi
    done < <(jq -r '.runtimeOptions | (.frameworks // [.framework]) | .[] | "\(.name) \(.version)"' "$cfg" 2>/dev/null | sort -r)
  done < <(find "$BOTTLE_ROOT/drive_c" -name '*.runtimeconfig.json' -newer "$marker" -not -ipath '*/windows/*' -print0 2>/dev/null)
}

win_icon() {  # win_icon <id> <exe>: extrai o ícone do .exe; imprime o nome/caminho do ícone
  local id=$1 exe=$2 ico png idx
  ico="$HOME/.var/app/com.usebottles.bottles/cache/watermelon-$id.ico"
  png="$HOME/.local/share/icons/hicolor/256x256/apps/bottles-$id.png"
  mkdir -p "$(dirname "$ico")" "$(dirname "$png")"
  if ! flatpak run --command=icoextract com.usebottles.bottles "$exe" "$ico" >/dev/null 2>&1; then
    echo applications-games
    return
  fi
  if command -v magick >/dev/null; then
    idx=$(magick identify -format '%p %w\n' "$ico" 2>/dev/null | sort -k2 -n | tail -1 | cut -d' ' -f1)
    if magick "$ico[${idx:-0}]" -resize 256x256 "$png" 2>/dev/null; then
      rm -f "$ico"
      echo "bottles-$id"
      return
    fi
  fi
  echo "$ico"
}

win_shortcut() {  # win_shortcut <id> <nome> <pasta> <exe>
  local id=$1 name=$2 folder=$3 exe=$4 icon
  icon=$(win_icon "$id" "$folder/$exe")
  printf '%s\n' \
    '[Desktop Entry]' \
    'Type=Application' \
    "Name=$name" \
    "Comment=Programa do Windows (roda pelo Bottles, ambiente \"$BOTTLE\")" \
    "Exec=flatpak run --command=bottles-cli com.usebottles.bottles run -b $BOTTLE --program-id $id" \
    "Icon=$icon" \
    'Categories=Wine;' \
    "StartupWMClass=${exe,,}" > "$APPS_DIR/bottles-$id.desktop"
  ok "atalho no menu: $name"
}

install_windows() {
  step "Programa do Windows: $NAME"
  flatpak_ensure com.usebottles.bottles "Bottles (compatibilidade com Windows)"
  # Dá ao Bottles acesso de leitura à pasta do instalador
  flatpak override --user --filesystem="$(dirname "$FILE")":ro com.usebottles.bottles
  if ! "${BOTTLES_CLI[@]}" list bottles 2>/dev/null | grep -q "$BOTTLE"; then
    info "criando o ambiente Windows \"$BOTTLE\" (leva um minuto na primeira vez)"
    "${BOTTLES_CLI[@]}" new --bottle-name "$BOTTLE" --environment application
  fi
  local marker before
  marker=$(mktemp)
  before=$(win_programs | cut -f1)
  info "abrindo o instalador; siga as telas dele normalmente"
  "${BOTTLES_CLI[@]}" run -b "$BOTTLE" -e "$FILE" >/dev/null 2>&1 || true   # o Bottles reconhece .exe e .msi

  ensure_dotnet "$marker"
  rm -f "$marker"

  # atalho no menu para cada programa novo (sem desinstaladores, manuais etc.)
  local n=0 id name folder exe
  while IFS=$'\t' read -r id name folder exe; do
    [[ -n $id ]] || continue
    grep -qxF "$id" <<<"$before" && continue
    [[ ${exe,,} == *.exe ]] || continue
    [[ ${name,,} =~ unins|uninstall|desinstal|readme|leia-me|manual|help|ajuda ]] && continue
    win_shortcut "$id" "$name" "$folder" "$exe"
    n=$((n+1))
  done < <(win_programs)
  update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
  if ((n)); then
    ok "pronto: abra pelo menu de aplicativos (Super + Espaço)"
  else
    ok "pronto: se o programa não apareceu no menu, abra pelo app Bottles"
  fi
}

# ------------------------------------------------------------------ Android
install_android() {
  step "App Android: $NAME"
  command -v waydroid >/dev/null || die "Waydroid não está instalado nesta imagem"
  if [[ ! -d /var/lib/waydroid/images && ! -f /var/lib/waydroid/waydroid.cfg ]]; then
    info "primeira vez: baixando o Android (~1 GB, só acontece uma vez)"
    pkexec waydroid init
  fi
  if ! waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'; then
    info "ligando o Android"
    pkexec systemctl start waydroid-container.service
    (waydroid session start >/dev/null 2>&1 &)
    for _ in $(seq 1 60); do
      waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING' && break
      sleep 2
    done
  fi
  waydroid app install "$FILE"
  ok "instalado: o app aparece no menu de aplicativos"
}

# ------------------------------------------------------------------ distrobox (.deb / .rpm)
install_in_box() {  # install_in_box <box> <imagem> <comando de instalação>
  local box=$1 image=$2 cmd=$3
  if ! distrobox list 2>/dev/null | awk -F'|' '{gsub(/ /,"",$2); print $2}' | grep -qx "$box"; then
    info "primeira vez: criando o container \"$box\" (só acontece uma vez)"
    distrobox create --yes --name "$box" --image "$image"
  fi
  distrobox enter "$box" -- bash -c "$cmd"
}

export_desktop_files() {  # export_desktop_files <box> <lista de .desktop>
  local box=$1; shift
  local n=0
  for d in "$@"; do
    distrobox enter "$box" -- distrobox-export --app "$(basename "$d" .desktop)" >/dev/null 2>&1 && n=$((n+1))
  done
  if ((n)); then ok "atalho criado no menu de aplicativos"; else info "é um programa de terminal: rode com 'distrobox enter $box -- <comando>'"; fi
}

install_deb() {
  step "Pacote .deb: $NAME"
  info "roda num container Ubuntu integrado ao sistema"
  install_in_box ubuntu docker.io/library/ubuntu:24.04 \
    "sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y '$FILE'"
  mapfile -t desktops < <(dpkg-deb -c "$FILE" 2>/dev/null | awk '{print $NF}' | grep '/usr/share/applications/.*\.desktop$' || true)
  export_desktop_files ubuntu "${desktops[@]}"
}

install_rpm() {
  step "Pacote .rpm: $NAME"
  info "roda num container Fedora integrado ao sistema (o sistema base continua intacto)"
  install_in_box fedora "registry.fedoraproject.org/fedora-toolbox:$(rpm -E %fedora)" "sudo dnf install -y '$FILE'"
  mapfile -t desktops < <(rpm -qlp "$FILE" 2>/dev/null | grep '/usr/share/applications/.*\.desktop$' || true)
  export_desktop_files fedora "${desktops[@]}"
}

# ------------------------------------------------------------------ AppImage
install_appimage() {
  step "AppImage: $NAME"
  local dest="$HOME/Applications" tmp app id icon
  mkdir -p "$dest"
  install -m 0755 "$FILE" "$dest/$NAME"
  app="$dest/$NAME"
  id="appimage-$(basename "$NAME" .AppImage | tr -c 'A-Za-z0-9._-' '-')"
  tmp=$(mktemp -d)
  (cd "$tmp" && "$app" --appimage-extract '*.desktop' >/dev/null 2>&1 && "$app" --appimage-extract '.DirIcon' >/dev/null 2>&1) || true
  icon="$HOME/.local/share/icons/$id.png"
  mkdir -p "$(dirname "$icon")"
  [[ -f $tmp/squashfs-root/.DirIcon ]] && cp -L "$tmp/squashfs-root/.DirIcon" "$icon" || icon="application-x-executable"
  local src
  src=$(find "$tmp/squashfs-root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -1)
  if [[ -n $src ]]; then
    sed -e "s|^Exec=[^ ]*|Exec=\"$app\"|" -e "s|^Icon=.*|Icon=$icon|" -e '/^TryExec=/d' "$src" > "$APPS_DIR/$id.desktop"
  else
    printf '[Desktop Entry]\nType=Application\nName=%s\nExec="%s"\nIcon=%s\nTerminal=false\n' \
      "$(basename "$NAME" .AppImage)" "$app" "$icon" > "$APPS_DIR/$id.desktop"
  fi
  rm -rf "$tmp"
  update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
  ok "instalado em ~/Applications com atalho no menu"
}

install_flatpakref() {
  step "Flatpak: $NAME"
  flatpak install --user -y --from "$FILE"
  ok "instalado"
}

case "${NAME,,}" in
  *.exe|*.msi)     install_windows ;;
  *.apk)           install_android ;;
  *.deb)           install_deb ;;
  *.rpm)           install_rpm ;;
  *.appimage)      install_appimage ;;
  *.flatpakref)    install_flatpakref ;;
  *) die "formato não suportado: $NAME" ;;
esac
