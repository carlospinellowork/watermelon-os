#!/usr/bin/python3
"""Bem-vindo ao WatermelonOS — assistente de primeiro login.

Passos: boas-vindas → internet → aparência → navegador → perfis → GitHub → Claude → pronto.
As instalações (navegador e perfis) rodam em segundo plano enquanto a pessoa
configura o GitHub e o Claude, e o progresso aparece no último passo.
"""
import os
import shlex
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Vte", "3.91")
gi.require_version("NM", "1.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, NM, Pango, Vte  # noqa: E402

APP_ID = "os.watermelon.Welcome"
SHARE = "/usr/share/watermelon"
STATE = os.path.join(GLib.get_user_config_dir(), "watermelon")
DONE = os.path.join(STATE, "welcome-done")
MIGRATION = "/sysroot/.watermelon-migration"


def old_system():
    """Nome do sistema anterior, se o WatermelonOS foi instalado por cima dele (sem pendrive)."""
    info = os.path.join(MIGRATION, "info")
    if not os.path.exists(info) or os.path.exists(os.path.join(MIGRATION, "imported")):
        return None
    for line in open(info):
        if line.startswith("OLD_OS="):
            return shlex.split(line.split("=", 1)[1])[0] if line.split("=", 1)[1].strip() else "sistema anterior"
    return "sistema anterior"

BROWSERS = [
    # id, nome, descrição, flatpak (None = já vem no sistema), arquivo .desktop
    ("chrome", "Google Chrome", "Recomendado · busca do Google e DevTools completas", "com.google.Chrome", "com.google.Chrome.desktop"),
    ("brave", "Brave", "Baseado no Chrome, com bloqueio de anúncios", "com.brave.Browser", "com.brave.Browser.desktop"),
    ("opera", "Opera", "Baseado no Chrome, com VPN e barra lateral", "com.opera.Opera", "com.opera.Opera.desktop"),
    ("firefox", "Firefox", "Já instalado · busca do Google configurada", None, "org.mozilla.firefox.desktop"),
]

PROFILES = [
    ("fullstack", "Fullstack", "Node.js LTS, Bun, pnpm, Python, Go, extensões do VS Code, Bruno (API) e DBeaver (bancos)", True),
    ("mobile", "Mobile", "Android Studio, Java 21, Flutter e acesso a celulares Android por USB", False),
    ("data", "Data / IA", "Python com uv, JupyterLab e Ollama para rodar modelos de IA localmente", False),
]

CSS = """
.wm-hero { font-size: 34px; font-weight: 800; letter-spacing: -0.5px; }
.wm-sub { font-size: 16px; opacity: .75; }
.wm-melon { color: #e8304a; }
.wm-term { border-radius: 12px; padding: 10px; background: #121614; }
