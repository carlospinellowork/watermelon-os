            return os.path.join(base, uuid)
    return None


def _libexec(name):
    """Programa auxiliar do sistema, ou o do repositório quando o app roda direto dele."""
    system = f"/usr/libexec/watermelon/{name}"
    repo = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    return system if os.path.exists(system) or not os.path.exists(repo) else repo


def ext_settings(uuid, schema_id):
    """Configurações de uma extensão (o schema fica dentro da pasta dela)."""
    d = extension_dir(uuid)
    if not d or not os.path.isdir(os.path.join(d, "schemas")):
        return None
    try:
        src = Gio.SettingsSchemaSource.new_from_directory(os.path.join(d, "schemas"),
                                                          Gio.SettingsSchemaSource.get_default(), False)
    except GLib.Error:
        return None
    schema = src.lookup(schema_id, False)
    return Gio.Settings.new_full(schema, None, None) if schema else None


def arc_settings():
    return ext_settings(ARC_UUID, "org.gnome.shell.extensions.watermelon-arc-dock")


def extension_enabled(uuid):
    shell = Gio.Settings.new("org.gnome.shell")
    return uuid in shell.get_strv("enabled-extensions") and uuid not in shell.get_strv("disabled-extensions")


def set_extension(uuid, on):
    """Liga/desliga pelo próprio GNOME Shell (efeito na hora); se não der, ajusta as listas do dconf."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync("org.gnome.Shell.Extensions", "/org/gnome/Shell/Extensions", "org.gnome.Shell.Extensions",
                      "EnableExtension" if on else "DisableExtension", GLib.Variant("(s)", (uuid,)),
                      None, 0, 5000, None)
        return
    except GLib.Error:
        pass
    shell = Gio.Settings.new("org.gnome.shell")
    en = [u for u in shell.get_strv("enabled-extensions") if u != uuid]
    dis = [u for u in shell.get_strv("disabled-extensions") if u != uuid]
    (en if on else dis).append(uuid)
    shell.set_strv("enabled-extensions", en)
    shell.set_strv("disabled-extensions", dis)


# ------------------------------------------------------------------ interface
class ThemePage(Gtk.ScrolledWindow):
    """Página com os temas instalados e o catálogo para baixar."""

    def __init__(self, win, kind):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.win, self.kind = win, kind
        self.key = "cursor-theme" if kind == "cursor" else "icon-theme"
        self.iface = Gio.Settings.new("org.gnome.desktop.interface")
        self.iface.connect(f"changed::{self.key}", lambda *_: self.refresh())
        self.busy = set()

        clamp = Adw.Clamp(maximum_size=960, margin_top=18, margin_bottom=24, margin_start=18, margin_end=18)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        clamp.set_child(self.box)
        self.set_child(clamp)

        if kind == "cursor":
            size_row = Gtk.Box(spacing=12)
            size_row.append(Gtk.Label(label="Tamanho", css_classes=["heading"], hexpand=True, xalign=0))
            group = Adw.ToggleGroup()
            for s in (24, 32, 48, 64):
                group.add(Adw.Toggle(label=str(s), name=str(s)))
            group.set_active_name(str(self.iface.get_int("cursor-size")))
            group.connect("notify::active-name",
                          lambda g, _p: self.iface.set_int("cursor-size", int(g.get_active_name())))
            size_row.append(group)
            self.box.append(size_row)

        head = Gtk.Box(spacing=12, margin_top=6)
        head.append(Gtk.Label(label="Instalados", css_classes=["title-4"], hexpand=True, xalign=0))
        add = Gtk.Button(label="Instalar de um arquivo…", css_classes=["flat"])
        add.connect("clicked", self.on_file)
        head.append(add)
        self.box.append(head)
        self.installed = self.flow()
        self.box.append(self.installed)

        self.box.append(Gtk.Label(label="Para baixar", css_classes=["title-4"], xalign=0, margin_top=18))
        self.catalog = self.flow()
        self.box.append(self.catalog)
        self.refresh()

    def flow(self):
        return Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                           min_children_per_line=1, max_children_per_line=3,
                           row_spacing=12, column_spacing=12)

    # ---- prévias
    def preview(self, path):
        row = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        if self.kind == "cursor":
            for names in CURSOR_PREVIEW:
                tex = next(filter(None, (load_xcursor(os.path.join(path, "cursors", n)) for n in names)), None)
                if tex:
                    pic = Gtk.Picture.new_for_paintable(tex)
                    pic.set_size_request(32, 32)
                    pic.set_can_shrink(True)
                    row.append(pic)
        else:
            theme = Gtk.IconTheme()
            theme.set_search_path([os.path.dirname(path)] + icon_dirs())
            theme.set_theme_name(os.path.basename(path))
            for n in ICON_PREVIEW:
                p = theme.lookup_icon(n, None, 32, 1, Gtk.TextDirection.LTR, 0)
                img = Gtk.Image.new_from_paintable(p)
                img.set_pixel_size(32)
                row.append(img)
        return row

    def card(self, title, subtitle, content, action):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["card", "wm-card"])
        pv = Gtk.Box(css_classes=["wm-preview"], hexpand=True)
        content.set_hexpand(True)
        pv.append(content)
        box.append(pv)
        info = Gtk.Box(spacing=8)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        text.append(Gtk.Label(label=title, css_classes=["wm-title"], xalign=0,
                              ellipsize=3))
        if subtitle:
            text.append(Gtk.Label(label=subtitle, css_classes=["dim-label", "caption"], xalign=0,
                                  wrap=True, max_width_chars=28))
        info.append(text)
        info.append(action)
        box.append(info)
        return box

    # ---- listas
    def refresh(self):
        current = self.iface.get_string(self.key)
        themes = installed_themes(self.kind)
        self.installed.remove_all()
        for name, (path, label, user) in sorted(themes.items(), key=lambda kv: kv[1][1].lower()):
            if name == current:
                act = Gtk.Label(label="✓ Em uso", css_classes=["wm-inuse"])
            else:
                act = Gtk.Box(spacing=4)
                use = Gtk.Button(label="Usar", css_classes=["suggested-action", "pill"], valign=Gtk.Align.CENTER)
                use.connect("clicked", lambda _b, n=name: self.apply(n))
                act.append(use)
                if user and not os.path.islink(path):
                    rm = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remover",
                                    css_classes=["flat", "circular"], valign=Gtk.Align.CENTER)
                    rm.connect("clicked", lambda _b, p=path: self.remove(p))
                    act.append(rm)
            self.installed.append(self.card(label, None, self.preview(path), act))

        self.catalog.remove_all()
        for e in CATALOG:
            if e["kind"] != self.kind or any(p in themes for p in e["provides"]):
                continue
            if e["title"] in self.busy:
                act = Adw.Spinner(width_request=24, height_request=24)
            else:
                act = Gtk.Button(label="Baixar", css_classes=["pill"], valign=Gtk.Align.CENTER)
                act.connect("clicked", lambda _b, en=e: self.fetch(en))
            icon = Gtk.Image(icon_name="folder-download-symbolic", pixel_size=32, opacity=0.4)
            self.catalog.append(self.card(e["title"], e["desc"], icon, act))

    # ---- ações
    def apply(self, name):
        self.iface.set_string(self.key, name)
        self.win.toast(f"{name} aplicado")

    def remove(self, path):
        name = os.path.basename(path)
        if self.iface.get_string(self.key) == name:
            self.iface.reset(self.key)
        shutil.rmtree(path, ignore_errors=True)
        self.refresh()
        self.win.toast(f"{name} removido")

    def fetch(self, entry):
        self.busy.add(entry["title"])
        self.refresh()

        def work():
            try:
                names = install_entry(entry)
                GLib.idle_add(self.done, entry, names, None)
            except Exception as exc:  # noqa: BLE001 — mostra qualquer falha para a pessoa
                GLib.idle_add(self.done, entry, None, exc)
        threading.Thread(target=work, daemon=True).start()

    def done(self, entry, names, error):
        self.busy.discard(entry["title"])
        self.refresh()
        if error:
            self.win.toast(f"Não deu para baixar {entry['title']}: {error}")
        else:
            self.apply(names[0])
        return False

    def on_file(self, _btn):
        dialog = Gtk.FileDialog(title="Escolha o arquivo do tema (.tar.gz, .tar.xz, .zip)")

        def picked(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            try:
                with tempfile.TemporaryDirectory(prefix="wm-theme-") as tmp:
                    extract(f.get_path(), tmp)
                    names = install_from_dir(tmp, self.kind)
                self.refresh()
                self.apply(names[0])
            except Exception as exc:  # noqa: BLE001
                self.win.toast(f"Não deu para instalar: {exc}")
        dialog.open(self.win, None, picked)


