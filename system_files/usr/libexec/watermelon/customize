BG_PROPS = [os.path.join(d, "gnome-background-properties") for d in
            [GLib.get_user_data_dir(), *GLib.get_system_data_dirs()]]


def wallpapers():
    """Lista (nome, arquivo, arquivo escuro, miniatura) dos papéis de parede registrados no sistema."""
    import xml.etree.ElementTree as ET
    out, seen = [], set()
    for d in BG_PROPS:
        if not os.path.isdir(d):
            continue
        for f in sorted(os.listdir(d)):
            try:
                root = ET.parse(os.path.join(d, f)).getroot()
            except (ET.ParseError, OSError):
                continue
            for w in root.iter("wallpaper"):
                if w.get("deleted") == "true":
                    continue
                fn = (w.findtext("filename") or "").strip()
                if not fn or fn in seen or not os.path.exists(fn):
                    continue
                seen.add(fn)
                dark = (w.findtext("filename-dark") or "").strip() or fn
                out.append((w.findtext("name") or os.path.basename(fn), fn, dark, thumb_source(fn)))
    return out


def thumb_source(path):
    """Para um XML dinâmico, usa a primeira imagem do dia como miniatura."""
    if not path.endswith(".xml"):
        return path
    import xml.etree.ElementTree as ET
    try:
        files = [e.text.strip() for e in ET.parse(path).getroot().iter("file") if e.text]
    except (ET.ParseError, OSError):
        return None
    day = [f for f in files if "day" in f]
    return (day or files or [None])[0]


class WallpaperPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.win = win
        self.bg = Gio.Settings.new("org.gnome.desktop.background")
        clamp = Adw.Clamp(maximum_size=960, margin_top=18, margin_bottom=24, margin_start=18, margin_end=18)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        head = Gtk.Box(spacing=12)
        head.append(Gtk.Label(label="Papéis de parede", css_classes=["title-4"], hexpand=True, xalign=0))
        pick = Gtk.Button(label="Escolher uma imagem…", css_classes=["flat"])
        pick.connect("clicked", self.on_pick)
        head.append(pick)
        box.append(head)
        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                min_children_per_line=1, max_children_per_line=3,
                                row_spacing=12, column_spacing=12)
        box.append(self.flow)
        clamp.set_child(box)
        self.set_child(clamp)
        self.bg.connect("changed::picture-uri", lambda *_: self.refresh())
        self.refresh()

    def refresh(self):
        current = self.bg.get_string("picture-uri")
        self.flow.remove_all()
        for name, fn, dark, thumb in wallpapers():
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["card", "wm-card"])
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, height_request=150, css_classes=["wm-thumb"])
            if thumb:
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(thumb, 480, 270, True)
                    _ok, png = pb.save_to_bufferv("png", [], [])
                    pic.set_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
                except GLib.Error:
                    pass
            card.append(pic)
            row = Gtk.Box(spacing=8)
            label = name + ("  ·  dinâmico" if fn.endswith(".xml") else "")
            row.append(Gtk.Label(label=label, css_classes=["wm-title"], xalign=0, hexpand=True,
                                 ellipsize=3))
            if current == Gio.File.new_for_path(fn).get_uri():
                row.append(Gtk.Label(label="✓ Em uso", css_classes=["wm-inuse"]))
            else:
                b = Gtk.Button(label="Usar", css_classes=["suggested-action", "pill"])
                b.connect("clicked", lambda _b, f=fn, d=dark: self.apply(f, d))
                row.append(b)
            card.append(row)
            self.flow.append(card)

    def apply(self, fn, dark):
        self.bg.set_string("picture-uri", Gio.File.new_for_path(fn).get_uri())
        self.bg.set_string("picture-uri-dark", Gio.File.new_for_path(dark).get_uri())
        self.bg.set_string("picture-options", "zoom")
        self.win.toast("Papel de parede aplicado")

    def on_pick(self, _b):
        dialog = Gtk.FileDialog(title="Escolha uma imagem")
        flt = Gtk.FileFilter(name="Imagens")
        flt.add_mime_type("image/*")
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(flt)
        dialog.set_filters(store)

        def picked(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            self.apply(f.get_path(), f.get_path())
        dialog.open(self.win, None, picked)


