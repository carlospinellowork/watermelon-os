# ------------------------------------------------------------------ temas instalados
def icon_dirs():
    dirs = [USER_ICONS, os.path.expanduser("~/.icons")]
    dirs += [os.path.join(d, "icons") for d in GLib.get_system_data_dirs()]
    seen, out = set(), []
    for d in dirs:
        r = os.path.realpath(d)
        if os.path.isdir(d) and r not in seen:
            seen.add(r)
            out.append(d)
    return out


def theme_label(path, name):
    try:
        with open(os.path.join(path, "index.theme"), encoding="utf-8", errors="ignore") as f:
            for line in f:
                if line.startswith("Name="):
                    return line.split("=", 1)[1].strip() or name
    except OSError:
        pass
    return name


def installed_themes(kind):
    """{nome: (pasta, rótulo, é_do_usuário)} — o primeiro diretório encontrado vence (usuário antes do sistema)."""
    found = {}
    for base in icon_dirs():
        user = not base.startswith("/usr")
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name)
            if name in found or not os.path.isdir(path):
                continue
            if kind == "cursor":
                if os.path.isdir(os.path.join(path, "cursors")):
                    found[name] = (path, theme_label(path, name), user)
            else:
                idx = os.path.join(path, "index.theme")
                if name in HIDDEN_ICON_THEMES or not os.path.exists(idx):
                    continue
                with open(idx, encoding="utf-8", errors="ignore") as f:
                    if "Directories=" in f.read():
                        found[name] = (path, theme_label(path, name), user)
    return found


def load_xcursor(path, size=40):
    """Lê um arquivo Xcursor e devolve a imagem mais próxima do tamanho pedido como Gdk.Texture."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return None
    if data[:4] != b"Xcur":
        return None
    _, _, ntoc = struct.unpack_from("<III", data, 4)
    images = []
    for i in range(ntoc):
        typ, sub, pos = struct.unpack_from("<III", data, 16 + i * 12)
        if typ == 0xFFFD0002:
            images.append((sub, pos))
    if not images:
        return None
    _, pos = min(images, key=lambda e: (abs(e[0] - size), -e[0]))
    w, h = struct.unpack_from("<II", data, pos + 16)
    pixels = data[pos + 36: pos + 36 + w * h * 4]
    return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED, GLib.Bytes.new(pixels), w * 4)


# ------------------------------------------------------------------ download e instalação
def http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def download(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=120) as r, open(dest, "wb") as f:
        shutil.copyfileobj(r, f)


def extract(archive, into):
    if zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as z:
            for m in z.namelist():
                target = os.path.realpath(os.path.join(into, m))
                if not target.startswith(os.path.realpath(into) + os.sep):
                    raise RuntimeError("arquivo com caminho inválido")
            z.extractall(into)
    else:
        with tarfile.open(archive) as t:
            t.extractall(into, filter="data")


def find_themes(root, kind):
    out = []
    for path, dirs, files in os.walk(root):
        if "index.theme" in files or (kind == "cursor" and "cursors" in dirs):
            is_cursor = os.path.isdir(os.path.join(path, "cursors"))
            if (kind == "cursor") == is_cursor:
                out.append(path)
            dirs[:] = []
    return out


def install_from_dir(root, kind, only=None):
    os.makedirs(USER_ICONS, exist_ok=True)
    names = []
    for src in find_themes(root, kind):
        name = os.path.basename(src.rstrip("/"))
        if only and name not in only:
            continue
        dest = os.path.join(USER_ICONS, name)
        if os.path.islink(dest) or os.path.isfile(dest):
            os.unlink(dest)
        elif os.path.isdir(dest):
            shutil.rmtree(dest)
        shutil.copytree(src, dest, symlinks=True)
        names.append(name)
    if not names:
        raise RuntimeError("nenhum tema encontrado no arquivo")
    return names


def install_entry(entry):
    with tempfile.TemporaryDirectory(prefix="wm-theme-") as tmp:
        rel = http_json(f"https://api.github.com/repos/{entry['repo']}/releases/latest")
        if "asset" in entry:
            url = next((a["browser_download_url"] for a in rel.get("assets", [])
                        if a["name"] == entry["asset"]), None)
            if not url:
                raise RuntimeError(f"{entry['asset']} não está no último release")
            archive = os.path.join(tmp, entry["asset"])
        else:
            url = rel["tarball_url"]
            archive = os.path.join(tmp, "source.tar.gz")
        download(url, archive)
        src = os.path.join(tmp, "src")
        os.makedirs(src)
        extract(archive, src)
        if "script" in entry:
            top = next((os.path.join(src, d) for d in os.listdir(src)), src)
            os.makedirs(USER_ICONS, exist_ok=True)
            subprocess.run(["bash", "install.sh", "-d", USER_ICONS, *entry["script"]], cwd=top,
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            return entry["provides"]
        return install_from_dir(src, entry["kind"], only=entry["provides"])



