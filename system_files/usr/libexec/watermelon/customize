TL_MARK = "/* watermelon: botões macOS */"


def _tl_css(name):
    """Arquivo do sistema; se ainda não existir (rodando direto do repositório), o do repositório."""
    system = f"/usr/share/watermelon/gtk/{name}"
    repo = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "share", "watermelon", "gtk", name)
    return system if os.path.exists(system) or not os.path.exists(repo) else os.path.realpath(repo)


TL_FILES = {"gtk-4.0": _tl_css("traffic-lights-gtk4.css"), "gtk-3.0": _tl_css("traffic-lights-gtk3.css")}


def _gtk_css(ver):
    return os.path.join(GLib.get_user_config_dir(), ver, "gtk.css")


def traffic_lights_enabled():
    try:
        with open(_gtk_css("gtk-4.0")) as f:
            return TL_MARK in f.read()
    except OSError:
        return False


def set_traffic_lights(on):
    """Liga/desliga só a nossa linha no gtk.css, sem mexer no resto que a pessoa tiver escrito."""
    for ver, css in TL_FILES.items():
        path = _gtk_css(ver)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            with open(path) as f:
                lines = [ln for ln in f.read().splitlines() if TL_MARK not in ln]
        except OSError:
            lines = []
        if on:
            lines.insert(0, f'@import url("file://{css}"); {TL_MARK}')
        with open(path, "w") as f:
            f.write("\n".join(lines) + ("\n" if lines else ""))


