#!/usr/bin/env bash
# melon — a ferramenta do WatermelonOS
set -euo pipefail

VERSION="0.1.0"
LIB=/usr/libexec/watermelon
RED=$'\e[38;2;255;84;104m' GRN=$'\e[38;2;125;211;160m' DIM=$'\e[2m' B=$'\e[1m' OFF=$'\e[0m'

usage() {
  cat <<EOF
${RED}🍉 melon${OFF} — a ferramenta do WatermelonOS

${B}Uso:${OFF}
  melon setup git      Conecta ao GitHub, cria a chave SSH, envia e configura o Git
  melon install <arq>  Instala .exe .msi .apk .deb .rpm .AppImage .flatpakref
  melon personalizar   Cursor, ícones, barra de cima e dock
  melon limpar         Acha lixo e caches que podem ser apagados (mostra antes)
  melon seguranca      Confere a segurança do sistema e dá uma nota
  melon doctor         Checa a saúde do sistema e das ferramentas (--corrigir)
  melon env            Cofre de variáveis dos projetos (dev/prod)
  melon foco [min]     Modo foco com Pomodoro na barra (melon foco parar)
  melon claude-ilha    Liga a ilha do Claude na barra (--tirar desliga)

${B}Git com IA:${OFF}
  melon commit         O Claude escreve a mensagem do commit a partir do diff
  melon pr             Branch + push + PR com título e descrição do Claude
  melon revisar        Revisão do Claude antes de enviar (bugs, segurança)
  melon conflitos      Abre o Claude para resolver conflitos de merge
  melon tarefa "…"     Tarefa em paralelo: worktree + branch + Claude (lista, limpar)
  melon standup        Resumo do que você fez, pronto para a daily
  melon pergunta "…"   Pergunta rápida ao Claude (--explicar: o que está copiado)
  melon status         Versão do sistema e atualizações pendentes
  melon version        Versão do melon e do sistema

${DIM}Em breve: melon up, melon backup, melon restore, melon doctor${OFF}
EOF
}

case "${1:-help}" in
  setup)
    case "${2:-}" in
      git) exec "$LIB/setup-git" ;;
      *)   echo "uso: melon setup git" >&2; exit 1 ;;
    esac ;;
  install)
    shift; exec "$LIB/install" "$@" ;;
  limpar|clean|cleanup)
    shift; exec "$LIB/cleanup" "$@" ;;
  seguranca|segurança|security)
    shift; exec "$LIB/security" "$@" ;;
  doctor|medico|médico)
    shift; exec "$LIB/doctor" "$@" ;;
  foco|focus|pomodoro)
    ext=watermelon-shell@watermelon.os
    for d in "$HOME/.local/share/gnome-shell/extensions/$ext/schemas" "/usr/share/gnome-shell/extensions/$ext/schemas"; do
      [[ -f $d/gschemas.compiled ]] && { SCHEMADIR=$d; break; }
    done
    [[ -n ${SCHEMADIR:-} ]] || { echo "extensão watermelon-shell não encontrada" >&2; exit 1; }
    case "${2:-}" in
      parar|stop|off) gsettings --schemadir "$SCHEMADIR" set org.gnome.shell.extensions.watermelon-shell focus-active false
                      echo "${GRN}Foco encerrado.${OFF}" ;;
      *)  [[ ${2:-} =~ ^[0-9]+$ ]] && gsettings --schemadir "$SCHEMADIR" set org.gnome.shell.extensions.watermelon-shell focus-minutes "$2"
          gsettings --schemadir "$SCHEMADIR" set org.gnome.shell.extensions.watermelon-shell focus-active true
          echo "${RED}🍅 Foco ligado${OFF} por $(gsettings --schemadir "$SCHEMADIR" get org.gnome.shell.extensions.watermelon-shell focus-minutes) min. Notificações em silêncio até o fim." ;;
    esac ;;
  commit|pr|revisar|review|conflitos|tarefa|task|standup|daily|pergunta|ask|"?")
    exec "$LIB/git-ai" "$@" ;;
  claude-ilha|claude-island)
    shift; exec "$LIB/claude-island-setup" "$@" ;;
  env|cofre|vault)
    shift; exec "$LIB/vault" "$@" ;;
  personalizar|customize)
    exec "$LIB/customize" "${2:-}" ;;
  status)
    # shellcheck disable=SC1091
    . /usr/lib/os-release
    echo "${GRN}${PRETTY_NAME}${OFF}"
    rpm-ostree status --booted 2>/dev/null | sed -n '2,6p'
    if rpm-ostree status 2>/dev/null | grep -q '^  staged'; then
      echo "${GRN}✔ Atualização baixada: entra na próxima vez que você reiniciar.${OFF}"
    else
      echo "${DIM}Nenhuma atualização pendente (o sistema verifica sozinho).${OFF}"
    fi ;;
  version|-v|--version)
    # shellcheck disable=SC1091
    . /usr/lib/os-release
    echo "melon $VERSION · $PRETTY_NAME" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
